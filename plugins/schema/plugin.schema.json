{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpgastudio.dev/schemas/plugin-v1.json",
  "title": "FPGA Studio declarative plugin",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "kind", "entry", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "name": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "kind": { "enum": ["board", "ip", "simulator", "analysis", "panel"] },
    "entry": { "type": "string" },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["read-project", "write-generated", "run-allowlisted-tool", "read-reports", "serial"] }
    }
  }
}
